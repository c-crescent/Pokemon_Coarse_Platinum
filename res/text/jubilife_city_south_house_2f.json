  "messages": [
    {
      "id": "JubilifeCitySouthHouse2F_EvolveWhenStrongerFromBattling",
      "en_US": [
        "Did you know?\r",
        "Some kinds of Pokémon evolve when\n",
        "they get stronger from battling!\r",
        "When they evolve, they can take on\n",
        "completely different forms!"
      ]
    },
    {
      "id": "JubilifeCitySouthHouse2F_EvolutionMakesMoreFascinating",
      "en_US": [
        "Evolution makes Pokémon just that\n",
        "much more fascinating.\r",
        "The mysteries of evolution... Can that\n",
        "dandy Prof. Rowan unravel them?"
      ]
    },
    {
      "id": "JubilifeCitySouthHouse2F_Breeder_TutorWhichPokemon",
      "en_US": [
        "I can teach your Pokémon moves that they\n",
        "can learn while leveling up.\r",
        "Which Pokémon needs tutoring?\r"
      ]
    },
    {
      "id": "JubilifeCitySouthHouse2F_Breeder_ComeBack",
      "en_US": [
        "Feel free to return any time.\r"
      ]
    },
    {
      "id": "JubilifeCitySouthHouse2F_Breeder_EggsCantLearnMoves",
      "en_US": [
        "Don’t you think it’d be tough for\n",
        "an Egg to learn a move?"
      ]
    },
    {
      "id": "JubilifeCitySouthHouse2F_Breeder_NoMovesToTeach",
      "en_US": [
        "Sorry...\r",
        "There isn’t any move I can teach\n",
        "that Pokémon."
      ]
    },
    {
      "id": "JubilifeCitySouthHouse2F_Breeder_TeachWhichMove",
      "en_US": "Which move should I teach?\r"
    }
  ]
}
